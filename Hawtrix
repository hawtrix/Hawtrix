name: Build Android APK

on:
  push:
    branches: [main, master]
  workflow_dispatch:

jobs:
  build:
    name: Build APK Android
    runs-on: ubuntu-latest
    timeout-minutes: 60

    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22

      - name: Setup pnpm
        uses: pnpm/action-setup@v4
        with:
          version: 9

      - name: "DIAGNOSTIC: Structure du projet"
        run: |
          echo "===== CONTENU DU DOSSIER ====="
          ls -la
          echo ""
          echo "===== VERSIONS ====="
          node --version
          pnpm --version
          echo ""
          echo "===== artifacts/hawtrix/package.json ====="
          cat artifacts/hawtrix/package.json

      - name: Install dependencies
        run: pnpm install

      - name: "DIAGNOSTIC: Dépendances installées"
        run: |
          echo "===== node_modules dans artifacts/hawtrix ====="
          ls artifacts/hawtrix/node_modules/ 2>&1 | head -20
          echo ""
          echo "===== expo version ====="
          cd artifacts/hawtrix && pnpm list expo 2>&1 || echo "expo non trouvé"

      - name: Install Expo CLI globally
        run: pnpm add -g expo-cli

      - name: Prebuild Android
        run: |
          cd artifacts/hawtrix
          echo "===== expo prebuild ====="
          npx expo prebuild --platform android --no-install 2>&1 | tail -30
          echo ""
          echo "===== Dossier android créé ? ====="
          ls -la android/ 2>&1 || echo "ERREUR: android/ non créé"
          ls -la android/app/ 2>&1 || echo "ERREUR: android/app/ non créé"

      - name: "DIAGNOSTIC: Fichiers Android"
        run: |
          cd artifacts/hawtrix
          echo "===== gradle files ====="
          find android -maxdepth 3 -name "*.gradle" | sort 2>&1
          echo ""
          echo "===== gradlew existe ? ====="
          ls -la android/gradlew 2>&1 || echo "ERREUR: gradlew introuvable"

      - name: Install packages after prebuild
        run: |
          cd artifacts/hawtrix
          pnpm install 2>&1 | tail -20

      - name: Setup Java JDK
        uses: actions/setup-java@v4
        with:
          distribution: 'zulu'
          java-version: '17'

      - name: Setup Android SDK
        uses: android-actions/setup-android@v3
        with:
          api-level: 34
          build-tools: 34.0.0

      - name: Accept Android licenses
        run: yes | sdkmanager --licenses 2>&1 | tail -5 || true

      - name: Bundle JS
        run: |
          cd artifacts/hawtrix
          mkdir -p android/app/src/main/assets
          npx react-native bundle \
            --platform android \
            --dev false \
            --entry-file index.js \
            --bundle-output android/app/src/main/assets/index.android.bundle \
            --assets-dest android/app/src/main/res \
            --reset-cache 2>&1 | tail -20
          echo ""
          echo "===== Bundle créé ? ====="
          ls -lh android/app/src/main/assets/index.android.bundle 2>&1 || echo "ERREUR: Bundle non créé"

      - name: Build APK
        run: |
          cd artifacts/hawtrix/android
          chmod +x ./gradlew
          ./gradlew assembleRelease \
            -x bundleReleaseJsAndAssets \
            -PreactNativeArchitectures=arm64-v8a,armeabi-v7a 2>&1 | tail -50
        env:
          CI: true

      - name: "DIAGNOSTIC: APK trouvé ?"
        run: |
          echo "===== Recherche APK ====="
          find artifacts/hawtrix/android -name "*.apk" -type f 2>&1
          echo ""
          APK_FILE=$(find artifacts/hawtrix/android/app/build/outputs/apk/release/ -name "*.apk" -type f | head -1)
          if [ -n "$APK_FILE" ]; then
            cp "$APK_FILE" hawtrix-v2.85.2-release.apk
            echo "APK_SIZE=$(du -h "$APK_FILE" | cut -f1)" >> $GITHUB_ENV
            echo "APK_READY=true" >> $GITHUB_ENV
          else
            echo "ERREUR: Aucun APK trouvé !"
            echo "APK_READY=false" >> $GITHUB_ENV
          fi

      - name: Upload APK
        if: env.APK_READY == 'true'
        uses: actions/upload-artifact@v4
        with:
          name: Hawtrix-v2.85.2-Android-APK
          path: hawtrix-v2.85.2-release.apk
          retention-days: 90

      - name: "DIAGNOSTIC FINAL"
        run: |
          echo "===== RESUME ====="
          echo "APK Ready: $APK_READY"
          echo "APK Size: $APK_SIZE"
          if [ "$APK_READY" = "false" ]; then
            echo "VERIFIEZ LES ETAPES DIAGNOSTIC CI-DESSUS"
          fi
